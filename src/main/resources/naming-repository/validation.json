{
  "area": {
    "pattern": "^[A-Z]{2,4}$",
    "minLength": 2,
    "maxLength": 4
  },
  "specificArea": {
    "pattern": "^[A-Z0-9]{1,4}$",
    "minLength": 1,
    "maxLength": 4
  },
  "device": {
    "pattern": "^[A-Z]{1,4}$",
    "minLength": 1,
    "maxLength": 4
  },
  "position": {
    "pattern": "^\\d{1,3}$",
    "minLength": 1,
    "maxLength": 3
  },
  "secondaryPosition": {
    "pattern": "^\\d{1,2}$",
    "minLength": 1,
    "maxLength": 2
  },
  "appendNumber": {
    "pattern": "^\\d{1,2}$",
    "minLength": 1,
    "maxLength": 2
  },
  "controller": {
    "pattern": "^[A-Z]{2,4}$",
    "minLength": 2,
    "maxLength": 4
  },
  "signal": {
    "pattern": "^[A-Z]{2,4}$",
    "minLength": 2,
    "maxLength": 4
  }
}
